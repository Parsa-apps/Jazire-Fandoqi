# 🏪 کلیدهای عمومی RSA فروشگاه‌ها (پرداخت درون‌برنامه‌ای).
#
# این فایل را به billing.properties کپی کنید و کلید هر فروشگاهی که در آن
# منتشر می‌کنید را بگذارید. کلیدها «عمومی» هستند و محرمانه نیستند، ولی از
# سورس بیرون نگه داشته می‌شوند تا هر انتشار بدون تغییر کد پیکربندی شود.
#
# یک APK واحد هر دو کلید را دارد و هنگام اجرا تشخیص می‌دهد از کدام
# فروشگاه نصب شده و همان درگاه را صدا می‌زند.
#
# اگر کلید یک فروشگاه خالی بماند، خرید در همان فروشگاه غیرفعال می‌شود
# (بقیه فروشگاه‌ها سالم کار می‌کنند).
#
# ⚠️ قالب مقدار: دقیقاً همان رشتهٔ Base64 که پنل می‌دهد — یک خط، بدون فاصله
# و خط جدید، و بدون چسباندن دو کلید به هم. بیلد release هر دو کلید را
# اعتبارسنجی می‌کند و اگر خراب باشند APK نمی‌سازد.

# پنل توسعه‌دهندهٔ کافه‌بازار → بخش پرداخت درون‌برنامه‌ای
bazaarRsaPublicKey=

# پنل توسعه‌دهندهٔ مایکت → برنامه‌ها → انتخاب برنامه → «پرداخت درون‌برنامه‌ای»
# → بالای تنظیمات → «کلید عمومی (شناسه پرداخت)»
# (یادآوری: «قیمت نصب» در اطلاعات پایه → تعیین قیمت باید **رایگان** باشد؛
# درآمد فقط از محصول درون‌برنامه‌ای می‌آید — docs/MYKET_FREE_INSTALL_IAP_FA.md)
myketRsaPublicKey=
