<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Bazaar's billing permission is contributed by Poolakey. It is repeated
         here to make the store contract explicit and auditable. The Myket SDK
         is not on this flavor's classpath; its permission is removed as a
         second, defensive isolation layer. -->
    <uses-permission android:name="com.farsitel.bazaar.permission.PAY_THROUGH_BAZAAR" />
    <uses-permission
        android:name="ir.mservices.market.BILLING"
        tools:node="remove" />

    <queries>
        <package android:name="com.farsitel.bazaar" />
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="bazaar" />
        </intent>
    </queries>
</manifest>
