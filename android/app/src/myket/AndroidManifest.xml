<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Myket accepts only its own billing contract. Myket's SDK is the only
         billing SDK on this flavor's classpath; the Bazaar permission is
         explicitly removed as a second, defensive isolation layer. -->
    <uses-permission android:name="ir.mservices.market.BILLING" />
    <uses-permission
        android:name="com.farsitel.bazaar.permission.PAY_THROUGH_BAZAAR"
        tools:node="remove" />

    <queries>
        <package android:name="ir.mservices.market" />
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="myket" />
        </intent>
    </queries>
</manifest>
