<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Teal sky background matching the new walnut-island launcher icon -->
    <item>
        <color android:color="#67C6F5"/>
    </item>
    <!-- Centered launcher icon on the splash screen -->
    <item
        android:width="192dp"
        android:height="192dp"
        android:gravity="center">
        <bitmap android:src="@mipmap/ic_launcher"/>
    </item>
</layer-list>
