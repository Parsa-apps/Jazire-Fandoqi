<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- تمِ پنجره تا پیش از رسم اولین فریمِ فلاتر.
         مشکی است تا با پس‌زمینهٔ اسپلش سینمایی یکی باشد و در حالت روشنِ
         سیستم هم فلاش سفید رخ ندهد. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:statusBarColor">@color/splash_background</item>
        <item name="android:navigationBarColor">@color/splash_background</item>
    </style>

    <!-- تمِ پنجره بعد از اولین فریم. مشکی می‌ماند تا هیچ لبهٔ سفیدی پشت
         رابط کاربریِ در حال گذار دیده نشود. -->
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
